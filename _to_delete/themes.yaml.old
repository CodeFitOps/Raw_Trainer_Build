      accent600: "#ff9179"
      accent-deep: "#ffa894"
      accent100: "#241715"
      accent200: "#331914"
      accent300: "#ffd0c4"
      accent-bright: "#ffb0a0"
      band-accent: "#a83318"
  - key: orchid
    name: ORCHID
    mode: dark
    colors:
      accent: "#f18ad0"
      accent600: "#f6a3da"
      accent-deep: "#f9bce4"
      accent100: "#22141f"
      accent200: "#301827"
      accent300: "#f9d6ee"
      accent-bright: "#f9bce4"
      band-accent: "#9c1f74"
  - key: sky
    name: SKY
    mode: dark
    colors:
      accent: "#7fb2ff"
      accent600: "#9cc4ff"
      accent-deep: "#bad6ff"
      accent100: "#121722"
      accent200: "#171f2e"
      accent300: "#d5e5ff"
      accent-bright: "#bad6ff"
