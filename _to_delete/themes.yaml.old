# RawTrainer — UI theme palette. SINGLE SOURCE OF TRUTH for every colour in the web UI.
#
# How it resolves: a theme's final colours = defaults[its mode] + its own `colors:` overrides.
# To recolour ONE item for ONE theme, add that token under the theme's `colors:` — it may be
# ANY token in `tokens:` below, not only the accents. To recolour something for every light
# (or dark) theme at once, edit defaults.light (or defaults.dark). The loader validates that
# every theme resolves every token, so nothing in the UI is left undefined.

# ── every themeable item in the UI, and what it paints (documentation; order is cosmetic) ──
tokens:
  desk: "outermost desktop margin behind the app frame"
  bg: "page / card background"
  surface: "raised surface — hints, panel headers washes"
  ink: "primary text and 2px borders"
  ink2: "secondary ink (subtle borders)"
  n300: "hairline dividers / lightest neutral"
  n400: "neutral"
  n500: "muted labels / mode arrows"
  n600: "secondary text"
  n700: "body text on toggles"
  n800: "strong neutral text (kv values)"
  accent: "primary accent — mark, stars, active row rail"
  accent600: "accent, one step deeper"
  accent-deep: "deepest accent — row numbers, band background"
  accent100: "accent tint — hover wash / expanded card"
  accent200: "accent tint 200"
  accent300: "accent tint 300"
  accent-bright: "bright accent highlight"
  band-accent: "player round-band accent"
  on-accent: "text / icons sitting on accent fills"
  field: "form field background"
  stage-bg: "player (live session) background"
  stage-ink: "player primary text"
  stage-2: "player secondary surface"
  stage-line: "player divider lines"
  stage-n300: "player neutral 300"
  stage-n400: "player neutral 400"
  stage-n500: "player neutral 500"
  stage-n600: "player neutral 600"

# ── shared palettes: the neutral / structural colours every light or dark theme starts from ──
defaults:
  light:
    desk: "#d7d3d3"
    bg: "#f3f2f2"
    surface: "#eae9e9"
    ink: "#201e1d"
    ink2: "#2d2b2b"
    n300: "#d7d3d3"
    n400: "#bab6b6"
    n500: "#9b9797"
    n600: "#7d7979"
    n700: "#605d5d"
    n800: "#444141"
    on-accent: "#ffffff"
    field: "#ffffff"
    stage-bg: "#201e1d"
    stage-ink: "#f3f2f2"
    stage-2: "#2d2b2b"
    stage-line: "#444141"
    stage-n300: "#d7d3d3"
    stage-n400: "#bab6b6"
    stage-n500: "#9b9797"
    stage-n600: "#7d7979"
  dark:
    desk: "#0a0a09"
    bg: "#141312"
    surface: "#1e1c1b"
    ink: "#ece9e6"
    ink2: "#2a2827"
    n300: "#302d2c"
    n400: "#55514f"
    n500: "#6e6a67"
    n600: "#8b8683"
    n700: "#a49f9c"
    n800: "#bdb8b4"
    on-accent: "#141312"
    field: "#1e1c1b"
    stage-bg: "#000000"
    stage-ink: "#ece9e6"
    stage-2: "#171615"
    stage-line: "#2b2928"
    stage-n300: "#cfcac7"
    stage-n400: "#a39e9a"
    stage-n500: "#8e8985"
    stage-n600: "#807b77"

# ── the themes. `colors:` holds this theme's overrides on top of defaults[mode] ──
# (today each only recolours the accent family; override any other token here to diverge).
themes:
  - key: red
    name: RED
    mode: light
    colors:
      accent: "#ec3013"
      accent600: "#dd2b0f"
      accent-deep: "#ae1800"
      accent100: "#fff2ef"
      accent200: "#ffe0d9"
      accent300: "#ffc4b8"
      accent-bright: "#ff9783"
      band-accent: "#ff9783"
  - key: magenta
    name: MAGENTA
    mode: light
    colors:
      accent: "#b5127a"
      accent600: "#9c0c68"
      accent-deep: "#7d0a53"
      accent100: "#fdeff8"
      accent200: "#f9d9ee"
      accent300: "#f2b3dc"
      accent-bright: "#ef8fca"
      band-accent: "#ef8fca"
  - key: blue
    name: BLUE
    mode: light
    colors:
      accent: "#1f4fd8"
      accent600: "#1740b8"
      accent-deep: "#14318f"
      accent100: "#eef2ff"
      accent200: "#dbe3ff"
      accent300: "#b9c8ff"
      accent-bright: "#8ea6ff"
      band-accent: "#8ea6ff"
  - key: graphite
    name: GRAPHITE
    mode: light
    colors:
      accent: "#3c424b"
      accent600: "#2b3038"
      accent-deep: "#21252c"
      accent100: "#f0f1f3"
      accent200: "#dfe1e5"
      accent300: "#c3c7ce"
      accent-bright: "#a7adb6"
      band-accent: "#a7adb6"
  - key: ember
