{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "for_time"
      ]
    },
    "description": {
      "type": "string"
    },
    "rounds": {
      "type": "integer"
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "reps": {
            "type": "integer"
          },
          "work_time_in_seconds": {
            "type": "integer"
          },
          "distance_in_meters": {
            "type": "number"
          },
          "weight": {
            "type": "number"
          },
          "percent_1rm": {
            "type": "number"
          },
          "rpe": {
            "type": "number"
          },
          "sets": {
            "type": "array",
            "description": "Esquema de reps por ronda como parametro (p.ej. 21-15-9) o carga por serie.",
            "items": {
              "type": "object",
              "properties": {
                "reps": {
                  "type": "integer"
                },
                "work_time_in_seconds": {
                  "type": "integer"
                },
                "weight": {
                  "type": "number"
                },
                "percent_1rm": {
                  "type": "number"
                },
                "rpe": {
                  "type": "number"
                }
              }
            }
          }
        },
        "required": [
          "name"
        ],
        "anyOf": [
          {
            "required": [
              "reps"
            ]
          },
          {
            "required": [
              "work_time_in_seconds"
            ]
          },
          {
            "required": [
              "distance_in_meters"
            ]
          },
          {
            "required": [
              "sets"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "exercises",
    "mode",
    "name",
    "description"
  ]
}
