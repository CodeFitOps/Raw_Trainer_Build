{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "edt"
      ]
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "work_time_in_minutes": {
      "type": "integer",
      "default": 20
    },
    "work_time_in_seconds": {
      "type": "integer",
      "description": "Ventana en segundos (alternativa a work_time_in_minutes; util para EDT corto/de prueba)."
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "name"
        ]
      }
    }
  },
  "required": [
    "exercises",
    "name",
    "mode"
  ]
}
