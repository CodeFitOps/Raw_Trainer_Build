{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "tabata"
      ]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "rounds": {
      "type": "integer",
      "default": 8
    },
    "rest_time_in_seconds": {
      "type": "integer",
      "default": 10
    },
    "work_time_in_seconds": {
      "type": "integer",
      "default": 20
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "reps": {
            "type": "integer"
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "reps"
        ]
      }
    }
  },
  "required": [
    "exercises",
    "name",
    "mode"
  ]
}
