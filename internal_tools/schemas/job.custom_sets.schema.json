{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "custom_sets",
        "super_sets"
      ]
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rounds": {
      "type": "integer"
    },
    "rest_between_exercises_in_seconds": {
      "type": "integer"
    },
    "rest_between_rounds_in_seconds": {
      "type": "integer"
    },
    "work_time_in_seconds": {
      "type": "integer"
    },
    "work_time_in_minutes": {
      "type": "integer"
    },
    "cadence": {
      "type": "string"
    },
    "tempo": {
      "type": "string",
      "description": "Tempo de 4 fases 'ecc-pausaAbajo-con-pausaArriba', p.ej. '3-1-1-0' (X = explosivo)."
    },
    "eccentric_neg": {
      "type": "boolean"
    },
    "isometric_hold": {
      "type": "boolean"
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "reps": {
            "type": "integer"
          },
          "work_time_in_seconds": {
            "type": "integer"
          },
          "weight": {
            "type": "number"
          },
          "percent_1rm": {
            "type": "number"
          },
          "rpe": {
            "type": "number"
          },
          "sets": {
            "type": "array",
            "description": "Prescripcion por serie: variacion de reps/tiempo/carga en cada serie (carga por serie, esquema de reps como parametro).",
            "items": {
              "type": "object",
              "properties": {
                "reps": {
                  "type": "integer"
                },
                "work_time_in_seconds": {
                  "type": "integer"
                },
                "weight": {
                  "type": "number"
                },
                "percent_1rm": {
                  "type": "number"
                },
                "rpe": {
                  "type": "number"
                }
              }
            }
          },
          "intra_set": {
            "type": "object",
            "description": "Estructura intra-serie: cluster / rest-pause / myo-reps / drop set.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "cluster",
                  "rest_pause",
                  "myo_reps",
                  "drop_set"
                ]
              },
              "rest_seconds": {
                "type": "integer"
              },
              "mini_sets": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "drops": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "weight": {
                      "type": "number"
                    },
                    "reps": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "name"
        ],
        "anyOf": [
          {
            "required": [
              "reps"
            ]
          },
          {
            "required": [
              "work_time_in_seconds"
            ]
          },
          {
            "required": [
              "sets"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "exercises",
    "mode",
    "name",
    "rounds"
  ]
}
