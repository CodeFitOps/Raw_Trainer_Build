{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "custom_sets",
        "super_sets"
      ]
    },
    "description": {
      "type": "string"
    },
    "rounds": {
      "type": "integer"
    },
    "rest_between_exercises_in_seconds": {
      "type": "integer"
    },
    "rest_between_rounds_in_seconds": {
      "type": "integer"
    },
    "work_time_in_seconds": {
      "type": "integer"
    },
    "work_time_in_minutes": {
      "type": "integer"
    },
    "cadence": {
      "type": "string"
    },
    "eccentric_neg": {
      "type": "boolean"
    },
    "isometric_hold": {
      "type": "boolean"
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "reps": {
            "type": "integer"
          },
          "work_time_in_seconds": {
            "type": "integer"
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "name"
        ],
        "anyOf": [
          {
            "required": [
              "reps"
            ]
          },
          {
            "required": [
              "work_time_in_seconds"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "exercises",
    "mode",
    "name",
    "rounds"
  ]
}
