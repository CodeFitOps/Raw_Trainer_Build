{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "ladder"
      ]
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ladder_type": {
      "type": "string",
      "enum": [
        "ASCENDING",
        "DESCENDING"
      ],
      "default": "ASCENDING"
    },
    "increment_by": {
      "type": "integer",
      "default": 1,
      "description": "Cuantas reps se añaden o quitan en cada ronda."
    },
    "total_rounds": {
      "type": "integer",
      "description": "El número total de peldaños en la escalera."
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "reps": {
            "type": "integer",
            "description": "Reps iniciales para el primer peldaño."
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "reps"
        ]
      }
    }
  },
  "required": [
    "exercises",
    "mode",
    "name",
    "total_rounds"
  ]
}
