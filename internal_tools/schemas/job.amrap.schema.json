{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "amrap"
      ]
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "work_time_in_minutes": {
      "type": "integer"
    },
    "work_time_in_seconds": {
      "type": "integer",
      "description": "Ventana en segundos (alternativa a work_time_in_minutes; util para AMRAP cortos)."
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "reps": {
            "type": "integer"
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "reps"
        ]
      }
    }
  },
  "required": [
    "exercises",
    "mode",
    "name"
  ],
  "anyOf": [
    {
      "required": [
        "work_time_in_minutes"
      ]
    },
    {
      "required": [
        "work_time_in_seconds"
      ]
    }
  ]
}
