{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "amrap"
      ]
    },
    "description": {
      "type": "string"
    },
    "work_time_in_minutes": {
      "type": "integer"
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "reps": {
            "type": "integer"
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "reps"
        ]
      }
    }
  },
  "required": [
    "exercises",
    "mode",
    "name",
    "work_time_in_minutes"
  ]
}
