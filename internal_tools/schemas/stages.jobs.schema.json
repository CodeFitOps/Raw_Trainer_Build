{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "NAME": {
      "type": "string"
    },
    "Description": {
      "type": "string"
    },
    "STAGES": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "NAME": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "JOBS": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "NAME": {
                  "type": "string"
                },
                "MODE": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "Rounds": {
                  "type": "integer"
                },
                "Rest_between_exercises_in_seconds": {
                  "type": "integer"
                },
                "Rest_between_rounds_in_seconds": {
                  "type": "integer"
                },
                "cadence": {
                  "type": "string"
                },
                "EXERCISES": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "NAME": {
                        "type": "string"
                      },
                      "reps": {
                        "type": "integer"
                      },
                      "work_time_in_seconds": {
                        "type": "integer"
                      },
                      "weight": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "NAME"
                    ]
                  }
                },
                "Eccentric (NEG)": {
                  "type": "boolean"
                },
                "isometric (HOLD)": {
                  "type": "boolean"
                },
                "rounds": {
                  "type": "integer"
                },
                "work_time_in_seconds": {
                  "type": "integer"
                },
                "rest_time_in_seconds": {
                  "type": "integer"
                },
                "work_time_in_minutes": {
                  "type": "integer"
                }
              },
              "required": [
                "EXERCISES",
                "MODE",
                "NAME",
                "description"
              ]
            }
          }
        },
        "required": [
          "Description",
          "JOBS",
          "NAME"
        ]
      }
    }
  },
  "required": [
    "Description",
    "NAME",
    "STAGES"
  ]
}