{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "emom"
      ]
    },
    "description": {
      "type": "string"
    },
    "rounds": {
      "type": "integer"
    },
    "work_time_in_seconds": {
      "type": "integer",
      "default": 60
    },
    "interval_in_seconds": {
      "type": "integer",
      "description": "Duracion de cada intervalo en segundos (60 = EMOM, 90 = E90, 120 = E2MOM)."
    },
    "death_by": {
      "description": "Variante Death-By: las reps ascienden en cada intervalo hasta el fallo. true = +1 por intervalo; objeto para fijar el incremento.",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "increment_by": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "reps": {
            "type": "integer"
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "reps"
        ]
      }
    }
  },
  "required": [
    "exercises",
    "mode",
    "name"
  ],
  "if": {
    "required": [
      "death_by"
    ]
  },
  "then": {},
  "else": {
    "required": [
      "rounds"
    ]
  }
}
